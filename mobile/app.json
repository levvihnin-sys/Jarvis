{
  "expo": {
    "name": "Рядом",
    "slug": "ryadom",
    "scheme": "ryadom",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ryadom",
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "app.ryadom",
      "adaptiveIcon": {
        "backgroundColor": "#6C4CF1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Система показывает название Wi‑Fi сети только приложениям с доступом к геолокации. Координаты используются, только если вы сами включите показ на карте, и огрубляются до района."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Фото нужно, чтобы поставить его в профиль. Оно хранится на телефоне и показывается только людям рядом."
        }
      ]
    ],
    "extra": {
      "serverUrl": "http://localhost:8080"
    }
  }
}
