# Скопируйте в окружение процесса (сервер не читает .env сам)
PORT=8080
HOST=0.0.0.0
DB_PATH=./data/ryadom.db
# За nginx/балансировщиком обязательно true (или список адресов прокси через запятую)
TRUST_PROXY=false
MAP_RECIPROCAL=true
MIN_GROUP=3
REPORT_THRESHOLD=3
BAN_HOURS=24
# ZONE_SECRET=<случайная строка>
