{
  "name": "@ryadom/server",
  "version": "0.1.0",
  "private": true,
  "description": "Сервер присутствия (WebSocket) и API кабинета заведений",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/index.ts",
    "start": "node --no-warnings=ExperimentalWarning dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@fastify/* --external:zod --external:tweetnacl --outfile=dist/index.js",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/static": "^11.0.0",
    "@fastify/websocket": "^11.3.0",
    "@ryadom/shared": "*",
    "fastify": "^5.6.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0",
    "ws": "^8.18.0"
  }
}
